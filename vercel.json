{
  "crons": [
    {
      "path": "/api/cron/recordatorios",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/limpiar-papelera-chats",
      "schedule": "0 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
